  "components": [
    {
      "name": "Primary action",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "The cabinet’s main room or turn action.",
      "html": "<button class=\"ds-button ds-primary\">Create a private room <span aria-hidden=\"true\">→</span></button>",
      "css": ".ds-button{display:flex;align-items:center;justify-content:space-between;gap:9px;width:100%;min-height:45px;padding:12px 13px;font-family:\"Barlow\",sans-serif;font-size:12px;font-weight:600;border-radius:5px;cursor:pointer;transition:background .15s ease,color .15s ease,opacity .15s ease}.ds-button:disabled{opacity:.42;cursor:not-allowed}.ds-button:focus-visible{outline:2px solid var(--lime,#c6ed72);outline-offset:4px;}@media(prefers-reduced-motion:reduce){.ds-button{transition:none}}.ds-primary{background:var(--lime,#c6ed72);border:1px solid var(--lime,#c6ed72);color:#1c2b19}.ds-primary:hover:not(:disabled){background:#d8f899}"
    },
    {
      "name": "Secondary action",
      "kind": "button",
      "refersTo": "button-secondary",
      "description": "A supporting or alternate game action.",
      "html": "<button class=\"ds-button ds-secondary\">Keep my cash <span aria-hidden=\"true\">→</span></button>",
      "css": ".ds-button{display:flex;align-items:center;justify-content:space-between;gap:9px;width:100%;min-height:45px;padding:12px 13px;font-family:\"Barlow\",sans-serif;font-size:12px;font-weight:600;border-radius:5px;cursor:pointer;transition:background .15s ease,color .15s ease,opacity .15s ease}.ds-button:disabled{opacity:.42;cursor:not-allowed}.ds-button:focus-visible{outline:2px solid var(--lime,#c6ed72);outline-offset:4px;}@media(prefers-reduced-motion:reduce){.ds-button{transition:none}}.ds-secondary{background:transparent;border:1px solid #52634b;color:#d6e0cb}.ds-secondary:hover:not(:disabled){background:#354630}"
    },
    {
      "name": "Danger action",
      "kind": "button",
      "refersTo": "button-danger",
      "description": "A consequential action paired with explanatory copy.",
      "html": "<button class=\"ds-button ds-danger\">Challenge to a shootout <span aria-hidden=\"true\">→</span></button>",
      "css": ".ds-button{display:flex;align-items:center;justify-content:space-between;gap:9px;width:100%;min-height:45px;padding:12px 13px;font-family:\"Barlow\",sans-serif;font-size:12px;font-weight:600;border-radius:5px;cursor:pointer;transition:background .15s ease,color .15s ease,opacity .15s ease}.ds-button:disabled{opacity:.42;cursor:not-allowed}.ds-button:focus-visible{outline:2px solid var(--lime,#c6ed72);outline-offset:4px;}@media(prefers-reduced-motion:reduce){.ds-button{transition:none}}.ds-danger{background:#ecaa7c;border:1px solid #ecaa7c;color:#30251e}.ds-danger:hover:not(:disabled){filter:brightness(1.1)}"
    },
    {
      "name": "Room field",
      "kind": "input",
      "refersTo": "field",
      "description": "Tracked room code input with a visible label.",
      "html": "<label class=\"ds-label\" for=\"ds-code\">ROOM CODE</label><input class=\"ds-field\" id=\"ds-code\" placeholder=\"ABC123\" maxlength=\"6\" />",
      "css": ".ds-label{display:block;margin-bottom:8px;color:#b7c5ab;font-family:\"Barlow\",sans-serif;font-size:9px;font-weight:600;letter-spacing:.1em}.ds-field{width:100%;min-height:45px;padding:13px 12px;background:#171e19;border:1px solid #465043;border-radius:6px;color:#f0f2e8;font-family:\"Barlow\",sans-serif;font-size:12px;font-weight:600;letter-spacing:.15em;text-transform:uppercase;transition:background .15s ease,color .15s ease,opacity .15s ease}.ds-field::placeholder{color:#a7afa2}.ds-field:focus-visible{outline:2px solid var(--lime,#c6ed72);outline-offset:2px}@media(prefers-reduced-motion:reduce){.ds-field{transition:none}}"
    },
    {
      "name": "Action navigation",
      "kind": "nav",
      "refersTo": "action-panel",
      "description": "Four native button tabs for turn, turf, trade, and chat.",
      "html": "<nav class=\"ds-tabs\" aria-label=\"Game panel\"><button class=\"ds-tab ds-current\">The move</button><button class=\"ds-tab\">My turf <span>2</span></button><button class=\"ds-tab\">Trade</button><button class=\"ds-tab\">Chat</button></nav>",
      "css": ".ds-tabs{display:flex;gap:15px;border-bottom:1px solid #42513a}.ds-tab{position:relative;display:flex;align-items:center;gap:4px;padding:0 0 13px;background:none;border:0;color:#b5c3aa;font-family:\"Barlow\",sans-serif;font-size:11px;white-space:nowrap;cursor:pointer}.ds-current{color:var(--lime,#c6ed72)}.ds-current:after{content:\"\";position:absolute;left:0;right:0;bottom:-1px;height:2px;background:var(--lime,#c6ed72)}.ds-tab span{padding:1px 4px;border-radius:3px;background:#37482e;color:#d4e3c4;font-size:8px}.ds-tab:hover{filter:brightness(1.1)}.ds-tab:focus-visible{outline:2px solid var(--lime,#c6ed72);outline-offset:4px;}"
    },
    {
      "name": "Crew badge",
      "kind": "chip",
      "refersTo": "crew-card",
      "description": "One of eight crew identities, combining a distinct color, symbol, and named accessible identity.",
      "html": "<span class=\"ds-crew-mark\" aria-label=\"Grove Collective\"><svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"m2 8 3 12h14l3-12-6 5-4-10-4 10-6-5Z\"/><path d=\"M5 21h14\"/></svg></span>",
      "css": ".ds-crew-mark{display:inline-flex;align-items:center;justify-content:center;width:34px;height:34px;color:var(--lime,#c6ed72);background:color-mix(in srgb,var(--lime,#c6ed72) 12%,#202722);border:1px solid color-mix(in srgb,var(--lime,#c6ed72) 45%,#202722);border-radius:50%}"
    },
    {
      "name": "Active crew card",
      "kind": "card",
      "refersTo": "crew-card",
      "description": "The current player’s roster surface and cash balance.",
      "html": "<article class=\"ds-crew-card\"><div class=\"ds-crew-name\">Your crew<small>Grove Collective</small></div><strong>$1,500</strong><span class=\"ds-in-play\">IN PLAY</span></article>",
      "css": ".ds-crew-card{position:relative;padding:15px 13px 13px;background:#253024;border:1px solid var(--lime,#c6ed72);border-radius:7px;color:#edf0e6;font-family:\"Barlow\",sans-serif}.ds-crew-name{font-size:13px;font-weight:600;line-height:1.1}.ds-crew-name small{display:block;margin-top:5px;color:#a8b29f;font-size:10px;font-weight:400}.ds-crew-card strong{display:block;margin-top:13px;font-size:18px;font-weight:600;letter-spacing:-.02em}.ds-in-play{position:absolute;right:11px;bottom:11px;color:var(--lime,#c6ed72);font-size:8px;letter-spacing:.1em}"
    },
    {
      "name": "Selected property tile",
      "kind": "custom",
      "refersTo": "board-tile-selected",
      "description": "A district-coded board button with explicit selected state; readable-map mobile names stay at 9px while overview names hide.",
      "html": "<button class=\"ds-tile\" aria-label=\"Auntie’s Bodega, $60\"><span class=\"ds-stripe\"></span><span class=\"ds-tile-name\">Auntie’s Bodega</span><span class=\"ds-price\">$60</span></button>",
      "css": ".ds-tile{position:relative;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:5px;width:88px;height:88px;padding:15px 3px 5px;background:#e1e6cc;border:1px solid #5a6854;border-radius:2px;color:#263326;font-family:\"Barlow\",sans-serif;outline:2px solid var(--lime,#c6ed72);outline-offset:0;cursor:pointer;transition:background .15s ease}.ds-stripe{position:absolute;left:0;right:0;top:0;height:14%;background:#a3ba86}.ds-tile-name{max-width:95%;font-size:12px;font-weight:700;line-height:1.15;text-align:center}.ds-price{font-size:10px;font-weight:500;line-height:1.05}.ds-tile:hover{background:#e0e3cf}.ds-tile:focus-visible{outline:2px solid var(--lime,#c6ed72);outline-offset:4px;}@media(prefers-reduced-motion:reduce){.ds-tile{transition:none}}"
    },
    {
      "name": "Street luck card",
      "kind": "card",
      "refersTo": "action-panel",
      "description": "A printed outcome surface with a direct consequence.",
      "html": "<article class=\"ds-street-card\"><span>STREET LUCK</span><h2>The block pays back</h2><p>Your pop-up sold out. Collect $250.</p></article>",
      "css": ".ds-street-card{position:relative;max-width:240px;min-height:285px;margin:8px;padding:24px 20px;background:#c1d494;border:2px solid #d8e5b6;border-radius:9px;color:#24351d;box-shadow:0 9px 18px #11181166;transform:rotate(-2deg);font-family:\"Barlow\",sans-serif}.ds-street-card>span{display:block;margin-bottom:18px;font-size:9px;font-weight:600;letter-spacing:.15em}.ds-street-card h2{margin:0;font-family:\"Barlow Condensed\",sans-serif;font-size:38px;font-weight:700;line-height:1.02;letter-spacing:-.015em}.ds-street-card p{max-width:180px;margin:15px 0 0;color:#304525;font-size:12px;line-height:1.55}"
    },
    {
      "name": "Decision dialog",
      "kind": "custom",
      "refersTo": "modal",
      "description": "The shared dark, bordered, scrollable surface for rules, settings, rooms, auctions, Stoppa, social, and profiles; 490px default and 610px wide.",
      "html": "<section class=\"ds-modal\" aria-label=\"Street rules\"><h2>Street rules</h2><p>Claim your blocks. Collect the rent. Keep your crew in play.</p><button class=\"ds-button ds-primary\">Let’s play <span aria-hidden=\"true\">→</span></button></section>",
      "css": ".ds-button{display:flex;align-items:center;justify-content:space-between;gap:9px;width:100%;min-height:45px;padding:12px 13px;font-family:\"Barlow\",sans-serif;font-size:12px;font-weight:600;border-radius:5px;cursor:pointer;transition:background .15s ease,color .15s ease,opacity .15s ease}.ds-button:disabled{opacity:.42;cursor:not-allowed}.ds-button:focus-visible{outline:2px solid var(--lime,#c6ed72);outline-offset:4px;}@media(prefers-reduced-motion:reduce){.ds-button{transition:none}}.ds-modal{max-width:490px;padding:28px;background:#253025;border:1px solid #637d51;border-radius:10px;color:#edf0e6;box-shadow:0 24px 80px #0009;font-family:\"Barlow\",sans-serif}.ds-modal h2{margin:0 0 20px;font-family:\"Barlow Condensed\",sans-serif;font-size:42px;font-weight:700;line-height:1.02;letter-spacing:-.015em}.ds-modal p{margin:0 0 20px;color:#c0d0b3;font-size:12px;line-height:1.6}.ds-primary{background:var(--lime,#c6ed72);border:1px solid var(--lime,#c6ed72);color:#1c2b19}.ds-primary:hover:not(:disabled){background:#d8f899}.ds-modal{max-height:90dvh;overflow:auto;overscroll-behavior:contain}.ds-modal.ds-wide{max-width:610px}.ds-modal label{display:block;font-size:14px;color:#d7dfce}.ds-modal p{line-height:1.5}"
    }
  ],
  "narrative": {
    "northStar": "Street game cabinet",
    "overview": "This documents the implemented direction recorded in `index.html`: a street game table where land, luck, and duels meet. Dark asphalt surfaces surround a pale square board, painted district strips, condensed sporting type, lime controls, and an original isometric city. The cabinet carries the visual identity; the room and turn controls make the game playable. The expanded board, eight crews, and supporting settings, room, social, and profile panels continue this same world.\n\nThe interface is dense around the board and more spacious around consequential actions. Friendly crew symbols and muted city colors give the original setting character without making players decode decoration. This is a record of the built system under the user's creative liberty. No approved visual comparisons, reference images, or image-generation assets were supplied.",
    "keyCharacteristics": [
      "Asphalt and olive surfaces with pale, readable board pieces.",
      "Condensed display type paired with direct, compact interface text.",
      "Lime action and focus treatments; crew and district colors carry game meaning.",
      "An authored vector city inside a real, interactive perimeter board.",
      "Responsive controls-first play and explicit keyboard focus."
    ],
    "rules": [
      {
        "name": "The Ownership Rule",
        "body": "Keep district and crew identity separate: a property's upper strip shows its district, its bottom strip shows its owner, and its circular tokens show occupants.",
        "section": "colors"
      }
    ],
    "dos": [
      "**Do** preserve the square perimeter board and the original city at its center.",
      "**Do** retain controls-first mobile presentation, contained readable-map scrolling, the full-map overview toggle, and focus the selected property detail.",
      "**Do** pair district and crew colors with names, symbols, strips, or explicit text.",
      "**Do** keep native keyboard activation, visible focus, dialog focus handling, and polite game announcements.",
      "**Do** self-host the existing Barlow families and honor reduced motion.",
      "**Do** state game consequences beside risky actions and outcomes."
    ],
    "donts": [
      "**Don't** reuse the district strip to imply ownership; the bottom owner bar has that job.",
      "**Don't** turn compact board metadata into primary instruction text.",
      "**Don't** remove disabled, selected, mortgaged, occupied, or eliminated state distinctions.",
      "**Don't** claim approved visual references or generated imagery that do not exist.",
      "**Don't** replace the authored city or crew identities with copied franchise artwork."
    ]
  }
}
